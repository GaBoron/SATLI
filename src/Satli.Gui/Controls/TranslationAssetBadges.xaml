<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="Satli_Gui.Controls.TranslationAssetBadges"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
        <Border x:Name="BinBadge" Visibility="Collapsed" Padding="8,1" CornerRadius="12" BorderThickness="1"
                Background="{ThemeResource BinBadgeBackground}" BorderBrush="{ThemeResource BinBadgeStroke}"
                ToolTipService.ToolTip="可安装本地 BIN">
            <TextBlock Text="BIN" FontSize="11" FontWeight="SemiBold" Foreground="{ThemeResource BinBadgeForeground}" />
        </Border>
        <Border x:Name="JsonBadge" Visibility="Collapsed" Padding="8,1" CornerRadius="12" BorderThickness="1"
                Background="{ThemeResource JsonBadgeBackground}" BorderBrush="{ThemeResource JsonBadgeStroke}"
                ToolTipService.ToolTip="可使用 lite 应用 JSON">
            <TextBlock Text="JSON" FontSize="11" FontWeight="SemiBold" Foreground="{ThemeResource JsonBadgeForeground}" />
        </Border>
    </StackPanel>
</UserControl>
