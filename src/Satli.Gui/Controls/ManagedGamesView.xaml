<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="Satli_Gui.Controls.ManagedGamesView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Satli_Gui.Controls"
    xmlns:models="using:Satli_Gui.Models"
    xmlns:viewModels="using:Satli_Gui.ViewModels"
    KeyboardAcceleratorPlacementMode="Hidden">
    <Grid Padding="32,24,32,16" RowSpacing="16">
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
        <StackPanel Spacing="4">
            <TextBlock Text="{x:Bind State.Title, Mode=OneWay}" Style="{StaticResource TitleTextBlockStyle}" />
            <TextBlock Text="{x:Bind State.Description, Mode=OneWay}" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
        </StackPanel>
        <CommandBar Grid.Row="1" DefaultLabelPosition="Right">
            <CommandBar.Content>
                <TextBlock
                    VerticalAlignment="Center"
                    Text="{x:Bind State.SelectedCountText, Mode=OneWay}"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </CommandBar.Content>
            <AppBarButton
                Icon="SelectAll"
                Label="{x:Bind State.SelectionActionText, Mode=OneWay}"
                Click="ToggleSelection_Click"
                KeyboardAcceleratorTextOverride="Ctrl+A" />
            <AppBarButton
                Label="锁定所选"
                Click="LockSelected_Click"
                Visibility="{x:Bind State.LockActionVisibility, Mode=OneWay}"
                AutomationProperties.Name="锁定所选游戏的 Steam 成就显示">
                <AppBarButton.Icon><FontIcon Glyph="&#xE72E;" /></AppBarButton.Icon>
            </AppBarButton>
            <AppBarButton
                Icon="UnPin"
                Label="解除所选"
                Click="UnlockSelected_Click"
                AutomationProperties.Name="解除所选游戏的 Steam 成就显示锁定" />
            <AppBarButton Icon="Refresh" Label="刷新状态" Click="Refresh_Click" KeyboardAcceleratorTextOverride="F5" />
        </CommandBar>
        <Grid Grid.Row="2">
        <ListView
            ItemsSource="{x:Bind State.Items, Mode=OneWay}"
            Visibility="{x:Bind State.ListVisibility, Mode=OneWay}"
            SelectionMode="None">
            <ListView.ItemContainerStyle>
                <Style TargetType="ListViewItem">
                    <Setter Property="HorizontalContentAlignment" Value="Stretch" /><Setter Property="Padding" Value="0" /><Setter Property="Margin" Value="0,0,0,8" />
                </Style>
            </ListView.ItemContainerStyle>
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="viewModels:ManagedGameRow">
                    <Border Style="{StaticResource GameCardStyle}">
                        <Grid ColumnSpacing="16">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <CheckBox
                                VerticalAlignment="Center"
                                IsChecked="{x:Bind IsSelected, Mode=TwoWay}"
                                Click="ManagedSelection_Click"
                                AutomationProperties.Name="{x:Bind Game.GameName}" />
                            <StackPanel Grid.Column="1" Spacing="4">
                                <TextBlock Text="{x:Bind Game.GameName}" Style="{StaticResource BodyStrongTextBlockStyle}" />
                                <TextBlock Text="{x:Bind Game.Subtitle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Style="{StaticResource CaptionTextBlockStyle}" />
                                <TextBlock Text="{x:Bind Game.ManagedSummaryText, Mode=OneWay}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Style="{StaticResource CaptionTextBlockStyle}" TextTrimming="CharacterEllipsis" />
                                <TextBlock
                                    Text="{x:Bind Game.ProtectionStatusText, Mode=OneWay}"
                                    Visibility="{x:Bind Game.ProtectionVisibility, Mode=OneWay}"
                                    Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                                    Style="{StaticResource CaptionTextBlockStyle}" />
                            </StackPanel>
                            <TextBlock Grid.Column="2" VerticalAlignment="Center" Text="{x:Bind Game.StateText}" Style="{StaticResource BodyStrongTextBlockStyle}" />
                            <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                <Button Width="80" HorizontalContentAlignment="Center" Content="编辑" Click="Edit_Click" Tag="{x:Bind Game}" IsEnabled="{x:Bind Game.CanViewInstalledTranslation}" AutomationProperties.Name="编辑当前翻译" />
                                <Button Width="80" HorizontalContentAlignment="Center" Content="更多" AutomationProperties.Name="更多操作">
                                    <Button.Flyout>
                                        <MenuFlyout>
                                            <MenuFlyoutItem Text="查看当前" Click="ViewCurrent_Click" Tag="{x:Bind Game}" IsEnabled="{x:Bind Game.CanViewInstalledTranslation}">
                                                <MenuFlyoutItem.Icon><SymbolIcon Symbol="View" /></MenuFlyoutItem.Icon>
                                            </MenuFlyoutItem>
                                            <MenuFlyoutItem Text="修改历史" Click="History_Click" Tag="{x:Bind Game}">
                                                <MenuFlyoutItem.Icon><SymbolIcon Symbol="Clock" /></MenuFlyoutItem.Icon>
                                            </MenuFlyoutItem>
                                            <MenuFlyoutSeparator />
                                            <MenuFlyoutItem Text="{x:Bind Game.ProtectionActionText, Mode=OneWay}" Click="Protection_Click" Tag="{x:Bind Game}" IsEnabled="{x:Bind Game.CanToggleProtection}">
                                                <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE72E;" /></MenuFlyoutItem.Icon>
                                            </MenuFlyoutItem>
                                            <MenuFlyoutSeparator />
                                            <MenuFlyoutItem Text="恢复安装前文件" Click="RestoreItem_Click" Tag="{x:Bind Game}" IsEnabled="{x:Bind Game.CanRestore}">
                                                <MenuFlyoutItem.Icon><SymbolIcon Symbol="Undo" /></MenuFlyoutItem.Icon>
                                            </MenuFlyoutItem>
                                        </MenuFlyout>
                                    </Button.Flyout>
                                </Button>
                            </StackPanel>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
            <controls:LoadingStateControl IsActive="{x:Bind State.IsLoading, Mode=OneWay}" />
            <StackPanel
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Spacing="8"
                Visibility="{x:Bind State.EmptyVisibility, Mode=OneWay}">
                <FontIcon Glyph="&#xE8FD;" FontSize="32" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                <TextBlock Text="{x:Bind State.EmptyTitle, Mode=OneWay}" Style="{StaticResource SubtitleTextBlockStyle}" />
                <TextBlock Text="{x:Bind State.EmptyDescription, Mode=OneWay}" TextWrapping="Wrap" HorizontalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
