<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="Satli_Gui.Controls.SteamLibrarySettingsControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel Spacing="8">
        <Border Style="{StaticResource SettingsCardStyle}">
            <StackPanel>
                <Grid Style="{StaticResource SettingsRowStyle}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center" Spacing="3">
                        <TextBlock
                            Text="补全账号游戏库"
                            Style="{StaticResource BodyStrongTextBlockStyle}" />
                        <TextBlock
                            Text="使用 Steam Web API 查找已拥有但从未安装或启动的游戏。"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            TextWrapping="Wrap" />
                    </StackPanel>
                    <StackPanel
                        Grid.Column="1"
                        Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        Spacing="8">
                        <TextBlock
                            x:Name="EnabledStateText"
                            Style="{StaticResource SettingsToggleStateTextStyle}" />
                        <ToggleSwitch
                            x:Name="EnabledSwitch"
                            Style="{StaticResource SettingsToggleSwitchStyle}"
                            Toggled="EnabledSwitch_Toggled"
                            AutomationProperties.Name="使用 Steam Web API 补全账号游戏库" />
                    </StackPanel>
                </Grid>
                <StackPanel
                    x:Name="CredentialsPanel"
                    Visibility="Collapsed">
                    <Border
                        Height="1"
                        Background="{ThemeResource CardStrokeColorDefaultBrush}" />
                    <StackPanel Padding="20,16" Spacing="12">
                        <TextBox
                            x:Name="SteamIdBox"
                            Header="SteamID64"
                            PlaceholderText="7656119xxxxxxxxxx"
                            MaxLength="17"
                            InputScope="Number"
                            LostFocus="Field_LostFocus"
                            AutomationProperties.HelpText="要查询的 Steam 账号的 17 位 SteamID64" />
                        <TextBlock
                            Text="获取方法：Steam 中打开“查看我的个人资料”并复制页面 URL；若地址包含 /profiles/765…，其后的 17 位数字就是 SteamID64。也可在 Steam 账户明细页面查看。"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            FontSize="12"
                            TextWrapping="Wrap" />
                        <PasswordBox
                            x:Name="ApiKeyBox"
                            Header="Steam Web API Key"
                            PlaceholderText="32 位十六进制字符"
                            MaxLength="32"
                            LostFocus="Field_LostFocus"
                            AutomationProperties.HelpText="从 Steam 开发者 API Key 页面获取的个人密钥" />
                        <StackPanel
                            Orientation="Horizontal"
                            Spacing="8">
                            <Button
                                Content="申请或管理 API Key"
                                Click="OpenApiKeyPage_Click"
                                AutomationProperties.Name="打开 Steam Web API Key 页面" />
                            <TextBlock
                                VerticalAlignment="Center"
                                Text="密钥使用当前 Windows 账户加密保存，只会直接发送给 Steam。"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                FontSize="12"
                                TextWrapping="Wrap" />
                        </StackPanel>
                    </StackPanel>
                </StackPanel>
            </StackPanel>
        </Border>

        <Border Style="{StaticResource SettingsCardStyle}">
            <Grid Style="{StaticResource SettingsRowStyle}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center" Spacing="3">
                    <TextBlock
                        Text="游戏库连接测试"
                        Style="{StaticResource BodyStrongTextBlockStyle}" />
                    <TextBlock
                        x:Name="TestStatusText"
                        Text="验证凭据并读取账号拥有的游戏数量。"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        TextWrapping="Wrap" />
                </StackPanel>
                <Button
                    x:Name="TestConnectionButton"
                    Grid.Column="1"
                    Content="测试 Steam 连接"
                    VerticalAlignment="Center"
                    Click="TestConnectionButton_Click"
                    AutomationProperties.Name="测试 Steam Web API 游戏库连接" />
            </Grid>
        </Border>
    </StackPanel>
</UserControl>
