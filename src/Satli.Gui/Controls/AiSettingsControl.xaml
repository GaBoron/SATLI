<UserControl
    x:Class="Satli_Gui.Controls.AiSettingsControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel Spacing="10">
        <TextBlock Text="AI 调用可能产生费用。翻译时仅向你选择的服务发送游戏名、App ID、成就 API ID 和实际可用的多语言文本；不发送完整 BIN、Steam 凭据或其他本机文件。" TextWrapping="Wrap" />
        <ComboBox x:Name="ProtocolBox" Header="接口类型" SelectedIndex="0" SelectionChanged="Protocol_Changed" HorizontalAlignment="Stretch">
            <ComboBoxItem Content="OpenAI Responses" Tag="responses" />
            <ComboBoxItem Content="OpenAI Chat Completions / 兼容接口" Tag="chat" />
            <ComboBoxItem Content="Anthropic Messages / 兼容接口" Tag="anthropic" />
        </ComboBox>
        <TextBox x:Name="EndpointBox" Header="完整 HTTPS 接口地址" />
        <TextBox x:Name="ModelBox" Header="模型名称（填写服务商提供的模型 ID）" />
        <PasswordBox x:Name="KeyBox" Header="API Key（留空保留已保存密钥）" />
        <TextBlock x:Name="KeyStatus" TextWrapping="Wrap" />
        <CheckBox x:Name="StructuredBox" Content="请求结构化输出（不支持时自动回退并在本地校验）" IsChecked="True" />
        <CheckBox x:Name="SearchBox" Content="允许 Responses / Anthropic 接口使用网页搜索（可能额外收费；不支持时回退）" />
        <TextBlock Text="密钥按当前 Windows 用户在本机加密保存。修改服务地址或接口类型时，需要重新填写密钥。AI 生成结果必须经人工校对。" TextWrapping="Wrap" />
        <StackPanel Orientation="Horizontal" Spacing="8">
            <Button Content="保存 AI 设置" Click="Save_Click" />
            <Button Content="清除密钥" Click="Clear_Click" />
            <Button x:Name="TestButton" Content="测试模型（会调用 API）" Click="Test_Click" />
        </StackPanel>
        <TextBlock x:Name="StatusText" TextWrapping="Wrap" />
    </StackPanel>
</UserControl>
