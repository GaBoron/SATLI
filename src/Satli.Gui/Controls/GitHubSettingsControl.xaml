<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="Satli_Gui.Controls.GitHubSettingsControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Border Style="{StaticResource SettingsCardStyle}">
        <Grid Style="{StaticResource SettingsRowStyle}" ColumnSpacing="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel VerticalAlignment="Center" Spacing="3">
                <TextBlock Text="GitHub 账户" Style="{StaticResource BodyStrongTextBlockStyle}" />
                <TextBlock
                    x:Name="AccountStatusText"
                    Text="正在读取绑定状态…"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    TextWrapping="Wrap" />
                <TextBlock
                    Text="用于在云端游戏页直接提交成就文件错误报告；不会上传本地 schema。"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    TextWrapping="Wrap" />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Spacing="8">
                <Image
                    x:Name="AccountAvatar"
                    Width="32"
                    Height="32"
                    Visibility="Collapsed"
                    Stretch="UniformToFill" />
                <Button x:Name="BindButton" Content="绑定 GitHub" Click="Bind_Click" />
                <Button x:Name="UnbindButton" Content="解绑" Click="Unbind_Click" Visibility="Collapsed" />
                <Button Content="管理授权" Click="ManageAuthorization_Click" />
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
