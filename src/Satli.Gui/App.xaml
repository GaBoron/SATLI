<?xml version="1.0" encoding="utf-8"?>
<Application
    x:Class="Satli_Gui.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Satli_Gui"
    xmlns:converters="using:Satli_Gui.Converters">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Light">
                    <SolidColorBrush x:Key="BinBadgeBackground" Color="#DDF4FF" />
                    <SolidColorBrush x:Key="BinBadgeForeground" Color="#0969DA" />
                    <SolidColorBrush x:Key="BinBadgeStroke" Color="#540969DA" />
                    <SolidColorBrush x:Key="JsonBadgeBackground" Color="#DAFBE1" />
                    <SolidColorBrush x:Key="JsonBadgeForeground" Color="#1A7F37" />
                    <SolidColorBrush x:Key="JsonBadgeStroke" Color="#541A7F37" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="Default">
                    <SolidColorBrush x:Key="BinBadgeBackground" Color="#1A2C42" />
                    <SolidColorBrush x:Key="BinBadgeForeground" Color="#79C0FF" />
                    <SolidColorBrush x:Key="BinBadgeStroke" Color="#5479C0FF" />
                    <SolidColorBrush x:Key="JsonBadgeBackground" Color="#173421" />
                    <SolidColorBrush x:Key="JsonBadgeForeground" Color="#7EE787" />
                    <SolidColorBrush x:Key="JsonBadgeStroke" Color="#547EE787" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="HighContrast">
                    <SolidColorBrush x:Key="BinBadgeBackground" Color="{ThemeResource SystemColorWindowColor}" />
                    <SolidColorBrush x:Key="BinBadgeForeground" Color="{ThemeResource SystemColorWindowTextColor}" />
                    <SolidColorBrush x:Key="BinBadgeStroke" Color="{ThemeResource SystemColorWindowTextColor}" />
                    <SolidColorBrush x:Key="JsonBadgeBackground" Color="{ThemeResource SystemColorWindowColor}" />
                    <SolidColorBrush x:Key="JsonBadgeForeground" Color="{ThemeResource SystemColorWindowTextColor}" />
                    <SolidColorBrush x:Key="JsonBadgeStroke" Color="{ThemeResource SystemColorWindowTextColor}" />
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
                <!-- Other merged dictionaries here -->
            </ResourceDictionary.MergedDictionaries>
            <converters:ZeroCountToVisibilityConverter x:Key="ZeroCountToVisibilityConverter" />
            <Style x:Key="GameCardStyle" TargetType="Border">
                <Setter Property="MinHeight" Value="116" />
                <Setter Property="Padding" Value="16" />
                <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
                <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="8" />
            </Style>
            <Style x:Key="LeftAlignedSearchTextBoxStyle" TargetType="TextBox" BasedOn="{StaticResource AutoSuggestBoxTextBoxStyle}">
                <Setter Property="TextAlignment" Value="Left" />
                <Setter Property="HorizontalContentAlignment" Value="Left" />
            </Style>
            <Style x:Key="SearchBoxStyle" TargetType="AutoSuggestBox">
                <Setter Property="TextBoxStyle" Value="{StaticResource LeftAlignedSearchTextBoxStyle}" />
                <Setter Property="CornerRadius" Value="{ThemeResource ControlCornerRadius}" />
            </Style>
            <Style x:Key="ToolbarSearchBoxStyle" TargetType="AutoSuggestBox" BasedOn="{StaticResource SearchBoxStyle}">
                <Setter Property="Height" Value="64" />
            </Style>
            <Style x:Key="ToolbarComboBoxStyle" TargetType="ComboBox">
                <Setter Property="Height" Value="64" />
                <Setter Property="HorizontalContentAlignment" Value="Left" />
                <Setter Property="CornerRadius" Value="{ThemeResource ControlCornerRadius}" />
            </Style>
            <Style x:Key="SettingsCardStyle" TargetType="Border">
                <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
                <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="8" />
            </Style>
            <Style x:Key="SettingsRowStyle" TargetType="Grid">
                <Setter Property="MinHeight" Value="88" />
                <Setter Property="Padding" Value="20,16" />
                <Setter Property="ColumnSpacing" Value="32" />
            </Style>
            <Style x:Key="SettingsSelectorStyle" TargetType="ComboBox">
                <Setter Property="Width" Value="180" />
                <Setter Property="HorizontalAlignment" Value="Right" />
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="CornerRadius" Value="{ThemeResource ControlCornerRadius}" />
            </Style>
            <Style x:Key="SettingsToggleSwitchStyle" TargetType="ToggleSwitch">
                <Setter Property="Width" Value="44" />
                <Setter Property="MinWidth" Value="0" />
                <Setter Property="HorizontalAlignment" Value="Right" />
                <Setter Property="HorizontalContentAlignment" Value="Right" />
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="OnContent" Value="{x:Null}" />
                <Setter Property="OffContent" Value="{x:Null}" />
            </Style>
            <Style x:Key="SettingsToggleStateTextStyle" TargetType="TextBlock">
                <Setter Property="MinWidth" Value="16" />
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="TextAlignment" Value="Right" />
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
