<Page xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:models="using:Satli_Gui.Models" x:Class="Satli_Gui.Pages.TranslationProjectsPage">
    <Grid Padding="32,24,32,16" RowSpacing="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <StackPanel Spacing="4">
            <TextBlock Text="翻译制作" Style="{StaticResource TitleTextBlockStyle}"/>
            <TextBlock Text="导入 JSON、获取公开原文或继续校对已保存的译文。" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap"/>
        </StackPanel>
        <CommandBar Grid.Row="1" DefaultLabelPosition="Right">
            <CommandBar.Content>
                <AutoSuggestBox x:Name="SearchBox" Width="280" PlaceholderText="搜索游戏或 App ID" QueryIcon="Find" TextChanged="Search_Changed"/>
            </CommandBar.Content>
            <AppBarButton Icon="Add" Label="公开数据新建" Click="Public_Click"/>
            <AppBarButton Icon="OpenFile" Label="导入 JSON" Click="Import_Click"/>
            <AppBarButton Icon="Download" Label="在线译本" Click="Catalog_Click"/>
        </CommandBar>
        <StackPanel Grid.Row="2" Spacing="8">
            <ProgressBar x:Name="Busy" IsIndeterminate="True" Visibility="Collapsed"/>
            <Button x:Name="CancelButton" Content="取消获取" Click="Cancel_Click" Visibility="Collapsed"/>
            <TextBlock x:Name="StatusText" TextWrapping="Wrap"/>
        </StackPanel>
        <Grid Grid.Row="3">
            <ListView x:Name="ProjectsList" SelectionMode="Single" IsDoubleTapEnabled="True" DoubleTapped="Projects_DoubleTapped">
                <ListView.ItemContainerStyle>
                    <Style TargetType="ListViewItem">
                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                        <Setter Property="Padding" Value="0"/>
                        <Setter Property="Margin" Value="0,0,0,8"/>
                    </Style>
                </ListView.ItemContainerStyle>
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="models:TranslationProjectItem">
                        <Border Style="{StaticResource GameCardStyle}">
                            <Grid ColumnSpacing="16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Spacing="4" VerticalAlignment="Center">
                                    <TextBlock Text="{x:Bind Name}" Style="{StaticResource BodyStrongTextBlockStyle}" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Text="{x:Bind Identity}" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                    <TextBlock Text="{x:Bind Saved}" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                </StackPanel>
                                <TextBlock Grid.Column="1" Text="{x:Bind Status}" VerticalAlignment="Center"/>
                                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                    <Button Content="继续编辑" Tag="{x:Bind}" Click="Resume_Click"/>
                                    <Button Content="更多">
                                        <Button.Flyout>
                                            <MenuFlyout>
                                                <MenuFlyoutItem Text="用 JSON 更新来源" Tag="{x:Bind}" Click="UpdateSource_Click"/>
                                            </MenuFlyout>
                                        </Button.Flyout>
                                    </Button>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
            <TextBlock x:Name="EmptyText" Text="还没有译文草稿。可导入 JSON，或从公开数据新建。" TextWrapping="Wrap" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Visibility="Collapsed"/>
        </Grid>
    </Grid>
</Page>
