<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="Satl_Gui.Pages.RevisionHistoryPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:Satl_Gui.Models">
    <Grid x:Name="PageLayout" Padding="32,24,32,16" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="3" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid ColumnSpacing="12">
            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
            <Button Click="Back_Click" Height="40" Padding="12,0">
                <StackPanel Orientation="Horizontal" Spacing="7">
                    <FontIcon Glyph="&#xE72B;" FontSize="15" />
                    <TextBlock Text="返回" VerticalAlignment="Center" />
                </StackPanel>
            </Button>
            <StackPanel Grid.Column="1" Spacing="3">
                <TextBlock x:Name="TitleText" Text="修订历史" Style="{StaticResource TitleTextBlockStyle}" />
                <TextBlock Text="Git 历史只追加；把旧版本设为当前时会生成新的提交。" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </StackPanel>
        </Grid>
        <ProgressBar Grid.Row="1" x:Name="BusyProgress" IsIndeterminate="True" Visibility="Collapsed" />
        <ListView Grid.Row="2" ItemsSource="{x:Bind Revisions, Mode=OneWay}" SelectionMode="None">
            <ListView.ItemContainerStyle>
                <Style TargetType="ListViewItem">
                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    <Setter Property="Padding" Value="0" />
                    <Setter Property="Margin" Value="0,0,0,8" />
                </Style>
            </ListView.ItemContainerStyle>
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="models:SchemaRevisionItem">
                    <Border Padding="14" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8">
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <StackPanel Spacing="4">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <TextBlock Text="{Binding TitleText}" Style="{StaticResource BodyStrongTextBlockStyle}" />
                                    <TextBlock Text="当前版本" Visibility="{x:Bind CurrentVisibility}" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                                </StackPanel>
                                <TextBlock Text="{x:Bind SummaryText}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <TextBlock Text="{x:Bind HashText}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                <Button Content="预览" Click="Preview_Click" Tag="{x:Bind}" IsEnabled="{x:Bind CanPreview}" />
                                <Button Content="导出" Click="Export_Click" Tag="{x:Bind}" IsEnabled="{x:Bind CanPreview}" />
                                <Button Content="设为当前" Click="Activate_Click" Tag="{x:Bind}" IsEnabled="{x:Bind CanActivate}" />
                            </StackPanel>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
        <TextBlock Grid.Row="3" x:Name="StatusText" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
    </Grid>
</Page>
