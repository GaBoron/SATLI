<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="Satl_Gui.Controls.DownloadSourceSettingsControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:Satl_Gui.Models">
    <UserControl.Resources>
        <Style x:Key="ReorderableSourceListItemStyle" TargetType="ListViewItem">
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="MinHeight" Value="56" />
        </Style>
    </UserControl.Resources>

    <StackPanel Spacing="8">
        <Border Style="{StaticResource SettingsCardStyle}">
            <StackPanel Padding="20,16" Spacing="10">
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Spacing="3">
                        <TextBlock Text="索引下载顺序" Style="{StaticResource BodyStrongTextBlockStyle}" />
                        <TextBlock
                            Text="拖动调整顺序；获取 index.json 时从上到下尝试，默认优先 GitHub Raw。"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            TextWrapping="Wrap" />
                    </StackPanel>
                    <Button
                        Grid.Column="1"
                        Content="恢复默认"
                        Click="ResetIndexOrder_Click"
                        AutomationProperties.Name="恢复默认索引下载顺序" />
                </Grid>
                <ListView
                    x:Name="IndexSourceList"
                    ItemsSource="{x:Bind IndexSources, Mode=OneWay}"
                    Background="Transparent"
                    SelectionMode="None"
                    IsItemClickEnabled="False"
                    IsSwipeEnabled="False"
                    ItemContainerStyle="{StaticResource ReorderableSourceListItemStyle}">
                    <ListView.ItemContainerTransitions>
                        <TransitionCollection>
                            <ReorderThemeTransition />
                        </TransitionCollection>
                    </ListView.ItemContainerTransitions>
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="models:DownloadSourceOption">
                            <Grid Padding="4,8" ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="28" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Thumb
                                    Width="28"
                                    MinHeight="40"
                                    Background="Transparent"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Stretch"
                                    DragStarted="SourceThumb_DragStarted"
                                    DragDelta="SourceThumb_DragDelta"
                                    DragCompleted="SourceThumb_DragCompleted"
                                    KeyDown="SourceThumb_KeyDown"
                                    ToolTipService.ToolTip="拖动调整顺序；也可用上下方向键"
                                    AutomationProperties.Name="调整下载源顺序">
                                    <Thumb.Template>
                                        <ControlTemplate TargetType="Thumb">
                                            <Grid Background="Transparent">
                                                <TextBlock
                                                    Text="&#x283F;"
                                                    FontFamily="Segoe UI Symbol"
                                                    FontSize="22"
                                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                    HorizontalAlignment="Center"
                                                    VerticalAlignment="Center"
                                                    IsHitTestVisible="False" />
                                            </Grid>
                                        </ControlTemplate>
                                    </Thumb.Template>
                                </Thumb>
                                <StackPanel Grid.Column="1" Spacing="2">
                                    <TextBlock Text="{x:Bind DisplayName}" Style="{StaticResource BodyStrongTextBlockStyle}" />
                                    <TextBlock
                                        Text="{x:Bind Description}"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        FontSize="12"
                                        TextWrapping="Wrap" />
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </StackPanel>
        </Border>

        <Border Style="{StaticResource SettingsCardStyle}">
            <StackPanel Padding="20,16" Spacing="10">
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Spacing="3">
                        <TextBlock Text="翻译文件下载顺序" Style="{StaticResource BodyStrongTextBlockStyle}" />
                        <TextBlock
                            Text="拖动调整顺序；下载并校验 BIN 文件时从上到下尝试。"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            TextWrapping="Wrap" />
                    </StackPanel>
                    <Button
                        Grid.Column="1"
                        Content="恢复默认"
                        Click="ResetFileOrder_Click"
                        AutomationProperties.Name="恢复默认文件下载顺序" />
                </Grid>
                <ListView
                    x:Name="FileSourceList"
                    ItemsSource="{x:Bind FileSources, Mode=OneWay}"
                    Background="Transparent"
                    SelectionMode="None"
                    IsItemClickEnabled="False"
                    IsSwipeEnabled="False"
                    ItemContainerStyle="{StaticResource ReorderableSourceListItemStyle}">
                    <ListView.ItemContainerTransitions>
                        <TransitionCollection>
                            <ReorderThemeTransition />
                        </TransitionCollection>
                    </ListView.ItemContainerTransitions>
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="models:DownloadSourceOption">
                            <Grid Padding="4,8" ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="28" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Thumb
                                    Width="28"
                                    MinHeight="40"
                                    Background="Transparent"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Stretch"
                                    DragStarted="SourceThumb_DragStarted"
                                    DragDelta="SourceThumb_DragDelta"
                                    DragCompleted="SourceThumb_DragCompleted"
                                    KeyDown="SourceThumb_KeyDown"
                                    ToolTipService.ToolTip="拖动调整顺序；也可用上下方向键"
                                    AutomationProperties.Name="调整下载源顺序">
                                    <Thumb.Template>
                                        <ControlTemplate TargetType="Thumb">
                                            <Grid Background="Transparent">
                                                <TextBlock
                                                    Text="&#x283F;"
                                                    FontFamily="Segoe UI Symbol"
                                                    FontSize="22"
                                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                    HorizontalAlignment="Center"
                                                    VerticalAlignment="Center"
                                                    IsHitTestVisible="False" />
                                            </Grid>
                                        </ControlTemplate>
                                    </Thumb.Template>
                                </Thumb>
                                <StackPanel Grid.Column="1" Spacing="2">
                                    <TextBlock Text="{x:Bind DisplayName}" Style="{StaticResource BodyStrongTextBlockStyle}" />
                                    <TextBlock
                                        Text="{x:Bind Description}"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        FontSize="12"
                                        TextWrapping="Wrap" />
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>
